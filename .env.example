LUOPITA_PROVIDER=deepseek
LUOPITA_MODEL=deepseek-chat
LUOPITA_BASE_URL=https://api.deepseek.com
# Required for real replies. Leave empty to use mock LLM for smoke tests.
LUOPITA_API_KEY=

# Postgres in Docker Compose; use memory:// for local unittest / no-DB runs.
LUOPITA_DATABASE_URL=postgresql://luopita:luopita@postgres:5432/luopita
LUOPITA_REDIS_URL=redis://redis:6379/0

# Protect /api/* and the admin console. Leave empty only on trusted localhost.
LUOPITA_ADMIN_TOKEN=

# Local hot-reload overlay (omit or set COMPOSE_FILE=docker-compose.yml for production)
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

LUOPITA_HOST=0.0.0.0
LUOPITA_PORT=5170
LUOPITA_NAPCAT_ENABLED=true
LUOPITA_NAPCAT_URL=http://napcat:3000
# Demo token — change before exposing any port to the internet.
LUOPITA_NAPCAT_TOKEN=luopita
LUOPITA_TUI_ENABLED=true
LUOPITA_LOG_LEVEL=INFO

# NapCat Docker (mlikiowa/napcat-docker)
# Before first start: export NAPCAT_UID=$(id -u) NAPCAT_GID=$(id -g)
NAPCAT_UID=1000
NAPCAT_GID=1000
# Demo WebUI token — change in production.
NAPCAT_WEBUI_TOKEN=napcat
NAPCAT_HTTP_PORT=3000
NAPCAT_WS_PORT=3001
NAPCAT_WEBUI_PORT=6099
